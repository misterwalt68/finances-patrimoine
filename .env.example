# Copier ce fichier en .env.local et remplir. Ne jamais committer .env.local (déjà dans .gitignore).

# --- Base de données (Supabase) ---
# Project Settings > Database > Connection string (mode "Transaction pooler", port 6543)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# --- Auth (Supabase) ---
# Project Settings > API Keys ("Publishable and secret API keys")
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Adresses email autorisées à se connecter (Maxime + Amélie), séparées par des
# virgules. Sécurité en profondeur en plus du mot de passe : toute autre
# adresse est rejetée même avec un compte Supabase valide.
OWNER_EMAILS="maxime.walter1994@gmail.com,amelie@exemple.fr"

# --- IA ---
ANTHROPIC_API_KEY=""

# --- Cours de marché ---
TWELVEDATA_API_KEY=""

# --- Coinbase (lecture seule) ---
COINBASE_CDP_KEY_NAME=""
COINBASE_CDP_PRIVATE_KEY=""

# --- Enable Banking (DSP2) ---
# Control Panel > API applications > enregistrer une app (Production
# restreinte, réservée aux comptes de Maxime — SPEC.md §5.1/§12) — la clé
# privée .pem est générée et téléchargée par le navigateur, à coller ici
# avec des \n littéraux (même format que COINBASE_CDP_PRIVATE_KEY).
ENABLE_BANKING_APPLICATION_ID=""
ENABLE_BANKING_PRIVATE_KEY=""

# Application Sandbox séparée (banque de test) — sert à développer/tester le
# flux d'autorisation sans jamais toucher au vrai compte BoursoBank.
ENABLE_BANKING_SANDBOX_APPLICATION_ID=""
ENABLE_BANKING_SANDBOX_PRIVATE_KEY=""

# --- Webhook raccourci iOS ---
# Jeton secret long et aléatoire, envoyé en en-tête Authorization par le raccourci iOS.
IOS_SHORTCUT_WEBHOOK_TOKEN=""

# --- Jobs planifiés Vercel Cron ---
# Vercel envoie cet en-tête sur les routes /api/cron/* ; on vérifie qu'il correspond.
CRON_SECRET=""

# --- URL publique du site (redirections, liens dans les emails) ---
# http://localhost:3000 en local ; l'URL réelle du déploiement en production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
